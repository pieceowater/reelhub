---
# Reelhub secrets. Copy this file to vars.yml and set both passwords:
#
#     cp ansible/vars.yml.example ansible/vars.yml
#
# vars.yml is gitignored; this template is what gets committed. Everything that
# isn't a secret (usernames, ports, paths, categories) lives as a plain default
# in the `vars:` block at the top of ansible/deploy.yml instead — this file only
# exists to keep the two passwords below out of git. To change a non-secret
# setting, edit it there; to change a password, edit it here.

# The permanent qBittorrent Web UI password. On the very first run the playbook
# reads the one-time password the container prints to its log, then replaces it
# with this one.
qbt_new_pass: "CHANGE_ME_before_first_deploy"

# Password for the Jellyfin administrator account the headless setup wizard
# creates. Ignored if Jellyfin has already been set up — in that case your
# existing account and password stay as they are.
jellyfin_admin_pass: "CHANGE_ME_before_first_deploy"
