---
# Reelhub secrets. Copy this file to vars.yml and set one password:
#
#     cp ansible/vars.yml.example ansible/vars.yml
#
# vars.yml is gitignored; this template is what gets committed. One password
# for everything (qBittorrent, Radarr, Sonarr, Prowlarr, Jellyfin) — the same
# username, `pcwt`, is already shared across all five as a plain default in
# ansible/deploy.yml.
#
# Want a different password for one service instead? Replace that line's
# value with a literal password instead of "{{ master_pass }}" — the others
# keep pointing at master_pass either way.

master_pass: "CHANGE_ME_before_first_deploy"

qbt_new_pass: "{{ master_pass }}"
jellyfin_admin_pass: "{{ master_pass }}"
radarr_admin_pass: "{{ master_pass }}"
sonarr_admin_pass: "{{ master_pass }}"
prowlarr_admin_pass: "{{ master_pass }}"

# The nightly config/ backup's encryption key (see ansible/deploy.yml,
# "Backups" section). Deliberately its own value, NOT "{{ master_pass }}":
# restic bakes this in permanently the first time it initializes the backup
# repo, so if you ever rotate master_pass, a value that followed it here
# would break every backup after that silently. Set it once, then leave it —
# and keep a copy somewhere else, because a lost restic password makes every
# existing backup permanently unreadable, with no recovery.
restic_pass: "CHANGE_ME_before_first_deploy_and_never_again"

# Telegram notifications from Jellyseerr ("your movie is ready") — optional,
# off while either is empty. Get telegram_bot_token from @BotFather
# (message it /newbot); telegram_chat_id is your own numeric chat id, read
# from https://api.telegram.org/bot<token>/getUpdates after you've sent that
# new bot at least one message yourself (bots can't message you first).
telegram_bot_token: ""
telegram_chat_id: ""
