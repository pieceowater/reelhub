# Optional overrides for docker-compose.yml. Copy to .env to use them.
# Every value here already has the same default baked into the compose file,
# so this file is only needed if you want something different.

# The user the containers create files as. On Linux set these to your own IDs
# (`id -u` and `id -g`) so downloads aren't owned by root. On macOS, Docker
# Desktop maps ownership for you and these can stay as they are.
PUID=1000
PGID=1000

# Timezone for logs, schedules and "added on" timestamps in the *arr apps.
TZ=Asia/Almaty
